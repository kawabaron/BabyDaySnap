{
  "expo": {
    "name": "BSnap",
    "slug": "bsnap",
    "version": "1.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bsnap",
    "userInterfaceStyle": "light",
    "locales": {
      "de": "./locales/metadata/de.json",
      "en": "./locales/metadata/en.json",
      "es": "./locales/metadata/es.json",
      "fr": "./locales/metadata/fr.json",
      "ja": "./locales/metadata/ja.json",
      "ko": "./locales/metadata/ko.json",
      "pt-BR": "./locales/metadata/pt-BR.json",
      "zh-CN": "./locales/metadata/zh-CN.json"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kawabaron.bsnap.app",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "Allow local network access to connect to the development server during debugging.",
        "NSBonjourServices": [
          "_expo._tcp",
          "_http._tcp"
        ],
        "NSCameraUsageDescription": "Allow camera access to take baby photos.",
        "NSPhotoLibraryUsageDescription": "Allow photo access to import baby photos.",
        "NSPhotoLibraryAddUsageDescription": "Allow photo library access to save edited photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#faedc5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "package": "com.bsnap.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#faedc5"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow camera access to take baby photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow photo access to import baby photos."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow photo library access to read photos for editing.",
          "savePhotosPermission": "Allow photo library access to save edited photos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-1542204891469444~7067398075",
          "delayAppMeasurementInit": true
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
        "monetization": {
          "adFreeProductId": "BSnap_ad_free",
          "seasonPackSpring2026ProductId": "season_pack_spring_2026",
          "createBannerUnitId": "ca-app-pub-1542204891469444/9762544876",
          "interstitialUnitId": "ca-app-pub-1542204891469444/4534535820"
        }
      }
  }
}
