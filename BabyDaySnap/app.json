{
  "expo": {
    "name": "BSnap",
    "slug": "bsnap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bsnap",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kawabaron.bsnap.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Allow camera access to take baby photos.",
        "NSPhotoLibraryUsageDescription": "Allow photo access to import baby photos.",
        "NSPhotoLibraryAddUsageDescription": "Allow photo library access to save edited photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#faedc5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "package": "com.bsnap.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#faedc5"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow camera access to take baby photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow photo access to import baby photos."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow photo library access to read photos for editing.",
          "savePhotosPermission": "Allow photo library access to save edited photos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "monetization": {
        "adFreeProductId": "ad_free",
        "seasonPackSpring2026ProductId": "season_pack_spring_2026",
        "createBannerUnitId": "ca-app-pub-3940256099942544/2435281174",
        "interstitialUnitId": "ca-app-pub-3940256099942544/4411468910"
      }
    }
  }
}
